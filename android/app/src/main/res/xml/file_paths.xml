<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!-- Rendered slates, handed out as content:// URIs by the share sheet. -->
    <cache-path
        name="slates"
        path="slates/" />
    <!-- Dive logs copied off an incoming share, so they survive the grant. -->
    <files-path
        name="logs"
        path="logs/" />
    <!--
      No path for updates. The app downloaded the APK itself until 0.4.0 and
      handed it to the package installer through here; it now opens the release
      page and lets the browser do both, so there is no update file to share.
    -->
</paths>
