<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!-- Rendered slates, handed out as content:// URIs by the share sheet. -->
    <cache-path
        name="slates"
        path="slates/" />
    <!-- Dive logs copied off an incoming share, so they survive the grant. -->
    <files-path
        name="logs"
        path="logs/" />
    <!--
      A downloaded update, handed to Android's package installer. It is another
      process, so a file:// URI would throw FileUriExposedException before it saw
      the bytes.
    -->
    <cache-path
        name="updates"
        path="updates/" />
</paths>
