<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Both of these exist for the updater, and for nothing else. The app reads
      local files and draws a picture; without self-update it would need no
      network at all.

      There is no store in this picture, so an install has no other way to learn
      that a fix exists. INTERNET is used for exactly two requests, both to
      github.com: the update manifest, and the APK the user agreed to fetch.

      REQUEST_INSTALL_PACKAGES only buys the right to *ask* — the user still
      grants "install unknown apps" for this app in Settings, and Android shows
      its own installer either way. Note it is a Play-restricted permission: if
      this app ever goes to the Play Store, the updater goes with it.

      It also costs a Play Protect warning, and that was weighed rather than
      overlooked. Fetching a binary and asking to install it is behaviourally
      what a dropper does, and 0.4.0 was refused with "Unsafe app blocked".
      0.4.1 removed this permission and handed off to the browser; 0.4.3 put it
      back deliberately, because the hand-off cost two extra taps and demoted
      checksum verification from enforced to merely displayed. Removing it again
      is a decision someone has already made twice — read the note in CLAUDE.md
      before making it a third time.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!--
      No <queries> block. Sharing goes through the system chooser, which resolves
      targets on the app's behalf without needing package visibility — the app
      never asks what is installed, so Android 11+ visibility filtering has
      nothing to hide from it.
    -->

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.DiveSlate">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              Receiving a dive log from Subsurface-mobile's export.

              text/* is a wildcard rather than an enumeration of subtypes, and
              that is the point: an earlier version listed text/xml and
              text/plain explicitly and Dive Slate simply did not appear in
              Subsurface's export chooser. The type it stamps is not documented
              and not guaranteed, so claiming the whole text tree is the only
              reliable way to be offered. Content is sniffed afterwards —
              detection is never by extension, and a shared content:// URI
              frequently carries no usable filename at all.

              These filters mirror Submersion's, which is known to appear in
              that chooser.
            -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/*" />
                <data android:mimeType="application/xml" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>

            <!-- An export may hand over several files at once. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/*" />
                <data android:mimeType="application/xml" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>

            <!--
              Opening a log from a file manager. The scheme is declared
              explicitly: a VIEW filter carrying only a mimeType matches no
              scheme at all on its own.

              content:// only, deliberately. Submersion also claims file://,
              but under scoped storage this app cannot read one — a file URI
              carries no grant, and reading /sdcard directly needs a permission
              we do not hold. Claiming it would mean appearing in a chooser and
              then failing, which is worse than not appearing. In practice
              nothing sends file:// anyway: exposing one throws
              FileUriExposedException on the sender since API 24.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" android:mimeType="text/*" />
                <data android:scheme="content" android:mimeType="application/xml" />
                <data android:scheme="content" android:mimeType="application/octet-stream" />
            </intent-filter>
        </activity>

        <!--
          Exported slates leave the app as content:// URIs, whichever target the
          user picks from the chooser. A file:// URI throws
          FileUriExposedException, so everything goes through here.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
