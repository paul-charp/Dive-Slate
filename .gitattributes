# Normalize line endings: store as LF in the repo and check out as LF too.
* text=auto eol=lf

# Explicit binary types (never normalize).
*.png binary
*.jpg binary
*.ico binary
*.pdf binary

# Dive logs and SVG are text, but fixtures must stay byte-stable for tests.
*.ssrf text eol=lf
*.uddf text eol=lf
*.svg text eol=lf
